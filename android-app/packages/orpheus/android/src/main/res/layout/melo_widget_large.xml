<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/melo_widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingVertical="10dp">
        <LinearLayout android:id="@+id/melo_widget_open" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/melo_widget_cover" android:layout_width="72dp" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:id="@+id/melo_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/melo_widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/melo_widget_progress_open" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="vertical">
            <ImageView android:id="@+id/melo_widget_progress" android:layout_width="match_parent" android:layout_height="8dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/melo_widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textSize="10sp" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:orientation="horizontal">
            <ImageButton android:id="@+id/melo_widget_previous" android:layout_width="64dp" android:layout_height="48dp" android:background="@android:color/transparent" android:padding="12dp" android:scaleType="fitCenter" />
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
                <ImageView android:id="@+id/melo_widget_play_background" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
                <ImageButton android:id="@+id/melo_widget_play" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:padding="12dp" android:scaleType="fitCenter" />
            </FrameLayout>
            <ImageButton android:id="@+id/melo_widget_next" android:layout_width="64dp" android:layout_height="48dp" android:background="@android:color/transparent" android:padding="12dp" android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
